---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A single image with a mono caption. Two ways to use it:
 *
 *   import shot from './images/gantry.jpg';
 *   <Figure src={shot} alt="…" caption="…" />
 *
 *   <Figure src="/photos/gantry.jpg" alt="…" caption="…" />   // from public/
 *
 * The imported form is preferred — it gets width/height (so the page doesn't
 * shift as images load), format conversion, and responsive sizes.
 */
interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  /** Let a wide image break out past the prose column. */
  wide?: boolean;
}
const { src, alt, caption, wide } = Astro.props;
const isImported = typeof src !== 'string';
---
<figure class="fig" data-wide={wide ? '' : undefined}>
  {isImported
    ? <Image src={src} alt={alt} widths={[640, 960, 1440]} sizes="(max-width: 760px) 100vw, 900px" loading="lazy" decoding="async" />
    : <img src={src} alt={alt} loading="lazy" decoding="async" />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

---
import Chip from '~/components/Chip.astro';
import type { Project } from '~/lib/content';

interface Props { project: Project }
const { project } = Astro.props;
const { title, tagline, domain, status, stack, tags } = project.data;
const href = `/projects/${project.id}/`;
---
<article class="card" data-domain={domain}>
  <div class="top">
    <h3><a href={href}>{title}</a></h3>
    <span class="slug">/projects/{project.id}</span>
  </div>
  <div class="chips">
    <Chip domain={domain} />
    <Chip status={status} />
  </div>
  <p>{tagline}</p>
  {stack.length > 0 && (
    <div class="foot"><span class="stack-list">{stack.slice(0, 4).join(' · ')}</span></div>
  )}
  {tags.length > 0 && (
    <ul class="tags">{tags.slice(0, 4).map((t) => <li>{t}</li>)}</ul>
  )}
</article>

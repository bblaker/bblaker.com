---
import { site, socials } from '~/site';
const year = new Date().getFullYear();
---
<footer class="foot">
  <span class="line">{year} · {site.name}</span>
  <ul class="links">
    {socials.map((s) => <li><a href={s.href} rel={s.rel}>{s.label}</a></li>)}
    <li><a href="/rss.xml">RSS</a></li>
  </ul>
</footer>

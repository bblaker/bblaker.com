---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Chip from '~/components/Chip.astro';
import SectionHead from '~/components/SectionHead.astro';
import SpecTable from '~/components/SpecTable.astro';
import DevlogRow from '~/components/DevlogRow.astro';
import { mdxComponents } from '~/components/mdx';
import { allProjects, devlog, type Project } from '~/lib/content';
import { monthYear } from '~/lib/format';

interface Props { project: Project }

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await allProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
};

const { project } = Astro.props;
const { title, tagline, domain, status, effort, started, ended, stack, links, spec } = project.data;

const { Content } = await render(project);
const entries = await devlog(project.id);
---
<Base title={title} description={tagline} section="projects" ogPath={`projects/${project.id}`}>
  <header class="proj-head">
    <p class="crumbs">
      <a href="/projects/">Projects</a> / <a href={`/projects/domain/${domain}/`}>{domain}</a> / {project.id}
    </p>
    <h1>{title}</h1>
    <p class="tagline">{tagline}</p>
    <div class="chips">
      <Chip domain={domain} />
      <Chip status={status} />
      {started && <Chip label={`Started ${monthYear(started)}`} />}
      {ended && <Chip label={`Ended ${monthYear(ended)}`} />}
      <Chip label={`Effort ${effort}`} />
      {entries.length > 0 && (
        <Chip label={`${entries.length} log ${entries.length === 1 ? 'entry' : 'entries'}`} />
      )}
    </div>
  </header>

  <div class="proj-body">
    <div class="prose">
      <Content components={mdxComponents} />
    </div>

    <aside class="rail">
      {spec.length > 0 && (
        <div class="rail-block">
          <p class="rt">Spec</p>
          <SpecTable rows={spec} />
        </div>
      )}
      {stack.length > 0 && (
        <div class="rail-block">
          <p class="rt">Stack</p>
          <div class="chips">{stack.map((s) => <Chip label={s} dot={false} />)}</div>
        </div>
      )}
      {links.length > 0 && (
        <div class="rail-block">
          <p class="rt">Links</p>
          <ul class="linklist">
            {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      )}
    </aside>
  </div>

  {entries.length > 0 && (
    <section class="section">
      <SectionHead label="Devlog" count={entries.length} moreLabel="Newest first" />
      <div class="rows">
        {entries.map(({ post, n }) => <DevlogRow post={post} n={n} />)}
      </div>
    </section>
  )}
</Base>
